const { onCall, HttpsError } = require("firebase-functions/v2/https");
const { defineSecret } = require("firebase-functions/params");
const OpenAI = require("openai");

const OPENAI_API_KEY = defineSecret("OPENAI_API_KEY");

exports.askBestie = onCall(
  { region: "europe-west1", secrets: [OPENAI_API_KEY], timeoutSeconds: 60 },
  async (request) => {
    if (!request.auth) {
      throw new HttpsError("unauthenticated", "Log in first.");
    }

    const messages = request.data && request.data.messages;
    if (!Array.isArray(messages) || messages.length === 0 || messages.length > 11) {
      throw new HttpsError("invalid-argument", "Send a short conversation.");
    }

    const safeMessages = messages.map((message) => {
      if (!message || !["user", "assistant"].includes(message.role) ||
          typeof message.content !== "string" || !message.content.trim()) {
        throw new HttpsError("invalid-argument", "Invalid chat message.");
      }
      return {
        role: message.role,
        content: message.content.slice(0, 2000)
      };
    });

    try {
      const apiKey = OPENAI_API_KEY.value();
      if (!apiKey) {
        throw new HttpsError("failed-precondition", "The OpenAI API key is not configured.");
      }

      const client = new OpenAI({ apiKey });
      const response = await client.responses.create({
        model: "gpt-6-luna",
        store: false,
        instructions: [
          "You are Virtual Bestie's friendly, thoughtful chat companion for a teen audience.",
          "Respond to the actual message and use the recent conversation for context. Do not repeat generic greetings or canned replies.",
          "Be warm, natural, specific, and honest. If you are unsure, say so instead of inventing facts.",
          "Use clear age-appropriate language. Do not produce sexual content, self-harm instructions, dangerous activity instructions, or guidance for obtaining restricted items.",
          "Do not ask for passwords, home addresses, phone numbers, school names, or other sensitive personal information.",
          "Do not claim to be a human, a real-life friend, or a substitute for trusted adults or professional help.",
          "If the user may be in immediate danger or is dealing with something serious, encourage them to contact a trusted adult or local emergency help.",
          "Answer in the language the user uses. Keep replies concise unless detail is useful."
        ].join(" "),
        input: safeMessages,
        max_output_tokens: 500
      });

      const answer = (response.output_text || "").trim();
      if (!answer) {
        throw new Error("The model returned an empty answer.");
      }
      return { answer };
    } catch (error) {
      if (error instanceof HttpsError) throw error;
      console.error("OpenAI request failed:", {
        status: error.status,
        code: error.code,
        message: error.message
      });

      if (error.status === 401 || error.status === 403) {
        throw new HttpsError("failed-precondition", "The OpenAI API key is invalid or lacks access.");
      }
      if (error.status === 404) {
        throw new HttpsError("failed-precondition", "The configured model is not available to this API account.");
      }
      if (error.status === 429) {
        throw new HttpsError("resource-exhausted", "The AI API quota or rate limit was reached.");
      }
      throw new HttpsError("internal", "The AI service could not complete the request.");
    }
  }
);

{
  "name": "virtual-bestie-functions",
  "description": "Secure AI chat backend for Virtual Bestie",
  "main": "index.js",
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0",
    "openai": "^5.0.0"
  }
}
